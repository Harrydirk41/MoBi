{
  "name": "Vantage RA QSP Model v1.0",
  "project_aliases": ["ra"],
  "disease": "rheumatoid arthritis; readout DAS28-CRP; ACR_Perc = 100*(DAS28_BL - DAS28_CRP)/DAS28_BL",
  "readout_desc": "first-line ACR20/50/70 + remission",
  "severity_readout": "DAS28-CRP",

  "_data_layout": "This file holds TASK SETUP only. The data is split out: model/parameters.json (parameter catalog + physiological ranges), data/calibration.json (training trials + baseline-severity target), data/validation.json (held-out trial), scenarios.json (protocols to simulate). The loader (qsp_config.load_tasks) merges them back in; a project that keeps everything here still loads unchanged. See DATA.md.",

  "readout_states": [
    "ACR20", "ACR50", "ACR70", "Remission",
    "MTX_NonResp", "MTX_NonResp_TCZ_ACR20", "MTX_NonResp_TCZ_ACR50",
    "MTX_NonResp_TCZ_ACR70", "MTX_NonResp_TCZ_Rem",
    "DAS28_CRP", "DAS28_BL"
  ],

  "timeline": {
    "baseline_captured_day": 199.0,
    "treatment_start_day": 200.0,
    "baseline_day": 200.0,
    "first_line_readout_day": 284.0,
    "second_line_readout_day": 600.0
  },

  "run_columns": {
    "patient": "patient",
    "first_line": {"ACR20": "ACR20", "ACR50": "ACR50", "ACR70": "ACR70", "remission": "Rem"},
    "subgroup_flag": "MTX_NonResp",
    "second_line": {"ACR20": "TCZ_ACR20", "ACR50": "TCZ_ACR50", "ACR70": "TCZ_ACR70", "remission": "TCZ_Rem"},
    "severity": {"baseline": "DAS28_base", "readout": "DAS28_read"}
  },

  "trial_objective": "Predict the second-line response in MTX-inadequate responders.",

  "drugs": {
    "MTX": {
      "drug": "methotrexate",
      "modality": "conventional synthetic DMARD (small molecule)",
      "mechanism": "antifolate; broad anti-inflammatory - the first-line anchor",
      "doses": ["MTX_15mg_Q1W_SC_t200", "MTX_9mg_Q1W_SC_t200", "MTX_2p5mgx3_Q1W_Oral_t200"]
    },
    "ADA": {
      "drug": "adalimumab",
      "modality": "biologic (anti-TNF-alpha monoclonal antibody)",
      "mechanism": "neutralizes TNF-alpha",
      "doses": ["ADA40mg_Q2W_SC_t200"]
    },
    "TCZ": {
      "drug": "tocilizumab",
      "modality": "biologic (anti-IL-6-receptor monoclonal antibody)",
      "mechanism": "blocks IL-6 signaling",
      "doses": ["TCZ8mgkg_Q4W_IV_t200", "TCZ4mgkg_Q4W_IV_t200"]
    },
    "SEC": {
      "drug": "secukinumab",
      "modality": "biologic (anti-IL-17A monoclonal antibody)",
      "mechanism": "neutralizes IL-17A",
      "doses": ["SEC_150mg_Q4W_t200", "SEC_75mg_Q4W_t200"]
    },
    "ana": {
      "drug": "anakinra",
      "modality": "biologic (IL-1 receptor antagonist)",
      "mechanism": "blocks IL-1 signaling",
      "doses": ["ana_100mg"]
    }
  },

  "fit_default_arm": "MTX_15mg_Q1W_SC_t200;TCZ8mgkg_Q4W_IV_t200@285",
  "fit_target": {"drug": "TCZ", "week": 24, "correction": "raw"},

  "vpop_anchors": {
    "arms": {"MTX": "MTX_15mg_Q1W_SC_t200"},
    "rate_targets": {"MTX": 33.7}
  },

  "validate_arms": {
    "prior_therapies": ["MTX_15mg_Q1W_SC_t200", "ADA40mg_Q2W_SC_t200"],
    "test_arm": "MTX_15mg_Q1W_SC_t200;TCZ8mgkg_Q4W_IV_t200@285"
  }
}
